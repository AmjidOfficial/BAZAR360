rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function userRole() {
      return isSignedIn()
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function isVehicleOwner(vehicleId) {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/vehicles/$(vehicleId)).data.ownerId == request.auth.uid;
    }

    function isShowroomOwner(showroomId) {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/showrooms/$(showroomId)).data.ownerUid == request.auth.uid;
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
    }

    function isValidVideo() {
      return request.resource.contentType.matches('video/.*')
        && request.resource.size < 100 * 1024 * 1024;
    }

    function isValidDocument() {
      return (
        request.resource.contentType == 'application/pdf' ||
        request.resource.contentType == 'application/msword' ||
        request.resource.contentType == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' ||
        request.resource.contentType == 'image/jpeg' ||
        request.resource.contentType == 'image/png'
      ) && request.resource.size < 25 * 1024 * 1024;
    }

    // Public media remains readable, but writes are ownership-controlled.
    match /profile-photos/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImage();
    }

    match /showroom-logos/{showroomId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isShowroomOwner(showroomId) || isAdmin()) && isValidImage();
    }

    match /showroom-banners/{showroomId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isShowroomOwner(showroomId) || isAdmin()) && isValidImage();
    }

    match /vehicle-images/{vehicleId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isVehicleOwner(vehicleId) || isAdmin()) && isValidImage();
    }

    match /vehicle-videos/{vehicleId}/{allPaths=**} {
      allow read: if true;
      allow write: if (isVehicleOwner(vehicleId) || isAdmin()) && isValidVideo();
    }

    // Verification and business documents are private.
    match /documents/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if (isOwner(userId) || isAdmin()) && isValidDocument();
    }

    match /inspection-reports/{vehicleId}/{allPaths=**} {
      allow read: if isVehicleOwner(vehicleId) || isAdmin();
      allow write: if (isVehicleOwner(vehicleId) || isAdmin()) && isValidDocument();
    }

    // Only administrators can publish or replace platform-controlled media.
    match /advertisements/{adId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    match /blog-images/{blogId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    match /temporary/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId);
    }

    match /showrooms/{ownerId}/vehicles/{vehicleId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(ownerId)
        && isVehicleOwner(vehicleId)
        && isValidImage();
    }
  }
}
