rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isAdmin() {
      return isSignedIn() && request.auth.token.email.lower() in [
        'amjid.bisconni@gmail.com',
        'amjid.psh@gmail.com',
        'khattakghani94@gmail.com',
        'ghani.khattak94@gmail.com',
        'mazharsouls@gmail.com'
      ];
    }
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function ownsDealer(dealerId) {
      return isVerified() && exists(/databases/$(database)/documents/dealers/$(dealerId)) &&
        get(/databases/$(database)/documents/dealers/$(dealerId)).data.ownerUid == request.auth.uid;
    }
    function ownsExistingListing() {
      return isVerified() && (
        (('ownerId' in existing()) && existing().ownerId == request.auth.uid) ||
        (('dealerId' in existing()) && existing().dealerId == request.auth.uid) ||
        (('dealerId' in existing()) && ownsDealer(existing().dealerId)) ||
        (('assignedSalesRepId' in existing()) && existing().assignedSalesRepId == request.auth.uid)
      );
    }

    match /dealers/{dealerId} {
      allow get: if true;
      allow list: if request.query.limit == null || request.query.limit <= 100;
      function isValidDealer(data) {
        return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
          data.ownerUid is string && data.ownerUid.size() > 0 && data.description is string && data.description.size() <= 2000;
      }
      // Only Admin creates or deletes showroom entities. Owners receive access after Admin assignment.
      allow create: if isAdmin() && isValidId(dealerId) && isValidDealer(incoming()) &&
        incoming().keys().hasAll(['name', 'ownerUid', 'description']);
      allow update: if isSignedIn() && isValidId(dealerId) && (
        isAdmin() || (
          isVerified() && existing().ownerUid == request.auth.uid && isValidDealer(incoming()) &&
          incoming().ownerUid == existing().ownerUid &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name','subtitle','description','about','location','phone','whatsapp','landline',
            'contactPerson','logo','coverImage','tagline','taglineCategory','socials','socialMedia',
            'theme_choice','themeSettings','gallery','media','updatedAt','likesCount','likes_count',
            'website','email','openingHours','amenities','services','businessCard','logoUrl','avatarUrl',
            'activityFeed','teamMembers'
          ])
        )
      );
      allow delete: if isAdmin();

      match /reviews/{reviewId} {
        allow get: if true;
        allow list: if request.query.limit == null || request.query.limit <= 100;
        allow create: if isSignedIn() && isValidId(reviewId) &&
          incoming().author is string && incoming().author == request.auth.uid &&
          incoming().rating is number && incoming().rating >= 1 && incoming().rating <= 5;
        allow update, delete: if isAdmin() || (isSignedIn() && existing().author == request.auth.uid);
      }
    }

    match /listings/{listingId} {
      allow get: if true;
      allow list: if request.query.limit == null || request.query.limit <= 100;
      function isValidListing(data) {
        return data.title is string && data.title.size() > 0 && data.title.size() <= 500 &&
          data.price is number && data.price >= 0 &&
          data.ownerId is string && data.ownerId.size() > 0 && data.ownerId == request.auth.uid &&
          data.dealerId is string && data.dealerId.size() > 0 && data.dealerId.size() <= 128;
      }
      allow create: if isVerified() && isValidId(listingId) && isValidListing(incoming()) && ownsDealer(incoming().dealerId);
      allow update: if isSignedIn() && isValidId(listingId) && (
        isAdmin() || (
          isVerified() && isValidListing(incoming()) && ownsExistingListing() &&
          incoming().ownerId == existing().ownerId &&
          incoming().dealerId == existing().dealerId &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'title','description','price','mileage','images','imageUrl','videoUrl','specs',
            'isSold','isPaused','isArchived','updatedAt','make','model','year','condition',
            'engineCC','exteriorColor','bodyCondition','fuelType','transmission','verified',
            'approved','assignedSalesRepId','dealerId','ownerId','phone','sellerPhone','tags',
            'assemblyType','tokenTaxStatus','tokenTaxPaid','registrationCity','documentType',
            'cloudinaryPublicId','cloudinaryPublicIds','videoCloudinaryPublicId','pdfUrl',
            'pdfCloudinaryPublicId','pdfTitle','status','primaryImage','showroomId','sellerWhatsApp'
          ])
        )
      );
      allow delete: if isAdmin() || (isVerified() && ownsExistingListing());

      match /comments/{commentId} {
        allow get: if true;
        allow list: if request.query.limit == null || request.query.limit <= 100;
        allow create: if isSignedIn() && incoming().userId == request.auth.uid;
        allow delete: if isAdmin() || isOwner(existing().userId);
      }
      match /likes/{userId} {
        allow get: if true;
        allow list: if request.query.limit == null || request.query.limit <= 100;
        allow write: if isOwner(userId);
      }
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && (!('role' in incoming()) || (incoming().role != 'Admin' && incoming().role != 'Super Admin'));
      allow update: if (isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly([
        'displayName','phoneNumber','city','state','socials','socialMedia','profilePhoto','photoURL',
        'logoUrl','coverImage','preferredLanguage','preferredTheme','whatsappNumber','updatedAt','lastLogin',
        'notificationSettings','privacySettings','address','dob','gender','bio','status','email'
      ])) || isAdmin();
      allow delete: if isAdmin();
    }

    match /profiles/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /leads/{leadId} {
      allow read: if isSignedIn() && (isOwner(resource.data.customerId) || isOwner(resource.data.showroomOwnerId) || isAdmin());
      allow create: if isSignedIn() && (isOwner(incoming().customerId) || incoming().customerId == 'guest');
      allow update: if isSignedIn() && (isOwner(resource.data.showroomOwnerId) || isAdmin());
      allow delete: if isAdmin();
    }

    match /bargains/{bargainId} {
      allow read: if isSignedIn() && (isOwner(resource.data.buyerUid) || isOwner(resource.data.dealerOwnerUid) || isAdmin());
      allow create: if isSignedIn() && (incoming().buyerUid == request.auth.uid || incoming().dealerOwnerUid == request.auth.uid);
      allow update: if isSignedIn() && (isOwner(resource.data.buyerUid) || isOwner(resource.data.dealerOwnerUid) || isAdmin());
      allow delete: if isAdmin();
    }

    match /posts/{postId} {
      allow get: if true;
      allow list: if request.query.limit == null || request.query.limit <= 100;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (isAdmin() || isOwner(existing().userId));
      allow delete: if isAdmin() || isOwner(existing().userId);
      match /comments/{commentId} {
        allow get: if true;
        allow list: if request.query.limit == null || request.query.limit <= 100;
        allow create: if isSignedIn() && incoming().userId == request.auth.uid;
        allow update, delete: if isAdmin() || isOwner(existing().userId);
      }
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /suggestions/{suggestionId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().keys().size() <= 20;
      allow update, delete: if isAdmin();
    }

    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if isSignedIn() && incoming().participants is list && request.auth.uid in incoming().participants;
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participants || isAdmin());
      match /messages/{messageId} {
        allow read: if isSignedIn() && (request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants || isAdmin());
        allow create: if isSignedIn() && incoming().senderId == request.auth.uid && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow update, delete: if isAdmin() || isOwner(existing().senderId);
      }
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /service_bookings/{bookingId} {
      allow get: if true;
      allow list: if isSignedIn() && (isAdmin() || request.query.limit == null || request.query.limit <= 100);
      allow create: if isSignedIn() && (incoming().customerId == request.auth.uid || incoming().userId == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (isAdmin() || resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.userId == request.auth.uid));
    }

    match /systemLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /searchHistory/{searchId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /system/{docId} {
      allow get: if true;
      allow list: if request.query.limit == null || request.query.limit <= 100;
      allow write: if isAdmin();
    }
  }
}